---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy | CogniElevate"
  description="Read the CogniElevate Privacy Policy to understand how information may be collected, used, and protected across our website and products."
  canonical="https://cognielevate.co/privacy/"
  robots="noindex, follow"
>

  <section class="privacy-hero" aria-labelledby="privacy-title">
    <div class="container">
      <p class="kicker">Legal</p>
      <h1 id="privacy-title">Privacy Policy</h1>
      <p class="lead">How CogniElevate handles information across this website and its products</p>
    </div>
  </section>

  <section class="privacy-content">
    <div class="container" style="max-width:860px;">
      <article class="policy-document">
        <header style="padding-bottom:1.25rem;margin-bottom:0;">
          <p style="font-size:0.85rem;color:var(--muted);margin-top:0.4rem;">Last updated: 2026</p>
        </header>

        <div class="policy-section">
          <h2>Overview</h2>
          <p>This Privacy Policy explains how CogniElevate collects, uses, and protects information when you visit our website or interact with products such as CogniFocus and Aptelle</p>
        </div>

        <div class="policy-section">
          <h2>Information We Collect</h2>
          <p>We may collect:</p>
          <ul>
            <li>Basic contact information such as email</li>
            <li>Device and browser information</li>
            <li>Usage and interaction data</li>
          </ul>
        </div>

        <div class="policy-section">
          <h2>How We Use Information</h2>
          <ul>
            <li>Improve product performance</li>
            <li>Respond to support requests</li>
            <li>Analyze usage trends</li>
          </ul>
        </div>

        <div class="policy-section">
          <h2>Data Sharing</h2>
          <p>We do not sell personal information. Data may be shared with trusted services that help operate the platform</p>
        </div>

        <div class="policy-section">
          <h2>Data Security</h2>
          <p>We apply reasonable safeguards, but no system is 100% secure</p>
        </div>

        <div class="policy-section">
          <h2>Your Rights</h2>
          <p>You may request access, updates, or deletion depending on your jurisdiction</p>
        </div>

        <div class="policy-section">
          <h2>Contact</h2>
          <p>Email: <a href="mailto:cognielevate@gmail.com" style="color:var(--accent);">cognielevate@gmail.com</a></p>
        </div>
      </article>
    </div>
  </section>

</BaseLayout>

<style>
  .privacy-hero {
    background-blend-mode: multiply;
    background-color: #0b1c2d;
    background-image: url('/assets/photos/night-sky.jpg');
    background-position: center;
    background-size: cover;
    padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(2.75rem, 5vw, 4.5rem);
    position: relative;
  }
  .privacy-hero::before { background: rgba(5, 20, 33, .68); content: ''; inset: 0; position: absolute; }
  .privacy-hero .container { position: relative; text-align: center; z-index: 1; }
  .privacy-hero h1 { font-size: clamp(2.75rem, 8vw, 7rem); margin: .6rem auto 1rem; max-width: none; white-space: nowrap; }
  .privacy-hero .lead { color: var(--text); margin: 0 auto; max-width: 40ch; }
  .privacy-content { padding: clamp(2.25rem, 5vw, 4.5rem) 0; }
  .policy-document { padding-top: 1.5rem; }
  .policy-section:first-of-type { border-top: 0; margin-top: 1rem; padding-top: 0; }
</style>
