---
import BaseLayout from '../layouts/BaseLayout.astro';
import Scene from '../components/Scene.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaPanel from '../components/CtaPanel.astro';
import {
  coreKeywords,
  organizationSchema,
  websiteSchema,
  cognifocusSoftwareSchema,
  webPageSchema,
  breadcrumbSchema,
  faqSchema,
} from '../data/seo.js';

const faqItems = [
  {
    question: 'What is CogniElevate?',
    answer: 'CogniElevate is a technology company building intelligent products and systems that reduce wasted time across several markets, starting with CogniFocus in the focus and productivity space.',
  },
  {
    question: 'Is CogniElevate only CogniFocus?',
    answer: 'No. CogniFocus is the first launched product, but CogniElevate is building a wider ecosystem of intelligent products across productivity, shopping, healthcare and robotics.',
  },
  {
    question: 'What is the long-term vision?',
    answer: 'The long-term vision is to create intelligent systems that remove friction and improve outcomes wherever people lose time, making everyday moments faster, clearer and more effective.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    websiteSchema,
    webPageSchema({
      id: 'https://cognielevate.co/#webpage',
      url: 'https://cognielevate.co/',
      name: 'CogniElevate | Intelligent systems that give people their time back',
      description: 'CogniElevate builds intelligent products that remove friction, speed up decisions and reduce wasted time across productivity, shopping, healthcare and robotics.',
      breadcrumb: true,
    }),
    breadcrumbSchema({
      id: 'https://cognielevate.co/#breadcrumb',
      items: [
        { name: 'Home', url: 'https://cognielevate.co/' },
      ],
    }),
    cognifocusSoftwareSchema,
    faqSchema(faqItems),
  ]
};

const frictionZones = [
  { icon: 'bell-off',   title: 'Attention lost',    body: 'Small interruptions break focus and drain momentum before meaningful work begins' },
  { icon: 'timer',      title: 'Decisions delayed', body: 'Unclear choices create hesitation and slow action across personal and professional life' },
  { icon: 'rotate-ccw', title: 'Returns & rework',  body: 'Mistakes turn into extra time, cost and repeated effort that compounds over time' },
  { icon: 'activity',   title: 'Operations slowed', body: 'Manual workflows create drag inside everyday systems, from clinics to warehouses' },
];

const markets = [
  { title: 'Focus & productivity', body: 'People lose hours to distraction. Building tools designed to protect attention and improve daily output', status: 'live' },
  { title: 'Fit & shopping',       body: 'Sizing is guesswork and returns waste time. Aptelle is our fit-intelligence product, now in early build', status: 'building' },
  { title: 'Healthcare systems',   body: 'Time is lost across care delivery. Future direction: intelligent systems that reduce friction in healthcare workflows', status: 'future' },
  { title: 'Robotics systems',     body: 'Time is lost in complex coordination. Future direction: systems that improve perception and efficiency in robotic operations', status: 'future' },
];

const marketBadge = { live: 'Live', building: 'Building', future: 'Future' };
---

<BaseLayout
  title="CogniElevate | Intelligent systems that give people their time back"
  description="CogniElevate builds intelligent products that remove friction, speed up decisions and reduce wasted time across productivity, shopping, healthcare and robotics."
  canonical="https://cognielevate.co/"
  keywords={[...coreKeywords, 'CogniElevate startup', 'AI productivity tools', 'focus systems for Android']}
  activePage="home"
  schema={schema}
>

  <!-- SCENE 1 — OPENING: IMMERSIVE HERO -->
  <section class="hero-immersive" aria-labelledby="hero-title">
    <div class="hero-immersive-photo" aria-hidden="true">
      <img src="/assets/photos/night-sky.jpg" alt="" width="1600" height="485" loading="eager" fetchpriority="high" />
    </div>
    <div class="hero-immersive-overlay" aria-hidden="true"></div>
    <div class="container hero-immersive-inner fade-up">
      <div class="hero-copy">
        <h1 class="hero-title" id="hero-title">
          Building systems that give people their
          <span class="accent"> time back</span>
        </h1>
        <p class="lead hero-lead">
          CogniElevate creates intelligent products that remove friction,
          speed up decisions and reduce wasted time across everyday life
          and complex industries
        </p>
        <div class="hero-actions">
          <a href="https://cognifocus.app/" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Try CogniFocus <span aria-hidden="true">↗</span></a>
          <a href="/about/" class="btn btn-outline btn-lg">Our vision</a>
        </div>
      </div>

      <div class="hero-media-wall" aria-hidden="true">
        <figure class="media-tile media-tile-product">
          <img src="/assets/products/cf-phone-wins.png" alt="" width="1080" height="1920" fetchpriority="high" />
        </figure>
        <figure class="media-tile media-tile-k2">
          <img src="/assets/photos/mountain-k2.jpg" alt="" width="1920" height="1274" loading="eager" />
        </figure>
        <figure class="media-tile media-tile-earth">
          <img src="/assets/photos/earthrise.jpg" alt="" width="1200" height="945" loading="eager" />
        </figure>
        <figure class="media-tile media-tile-session">
          <img src="/assets/products/cf-left-session.png" alt="" width="270" height="480" loading="eager" />
        </figure>
      </div>
    </div>
  </section>

  <!-- SCENE 2 — THE FRICTION FIELD: stats + problem -->
  <Scene class="section friction-scene" id="problem" aria-labelledby="problem-heading">
    <div class="container">
      <div class="stats-row" data-reveal-stagger aria-label="Key statistics">
        <div class="stat-cell">
          <span class="stat-num"><span data-count>2.1</span>h</span>
          <span class="stat-desc">focus time lost daily per person</span>
        </div>
        <div class="stat-cell">
          <span class="stat-num"><span data-count>23</span>m</span>
          <span class="stat-desc">to regain focus after one interruption</span>
        </div>
        <div class="stat-cell">
          <span class="stat-num"><span data-count>40</span>%</span>
          <span class="stat-desc">drop in productivity from task-switching</span>
        </div>
      </div>

      <SectionHead kicker="The problem" title="Time gets lost in small moments" id="problem-heading" align="center"
        intro="Distractions, wrong purchases, waiting rooms, admin work and slow systems all create the same cost: wasted time" />

      <div class="friction-field" data-reveal-stagger>
        {frictionZones.map(({ icon, title, body }) => (
          <article class="card card-p friction-node">
            <span class="friction-icon" aria-hidden="true">
              <img src={`/assets/icons/${icon}.svg`} alt="" width="18" height="18" loading="lazy" />
            </span>
            <h3 class="u-draw" style="font-size:1.05rem;margin-bottom:0.6rem;">{title}</h3>
            <p style="font-size:0.9rem;">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </Scene>

  <!-- SCENE 3 — FRICTION TO FLOW: principle -->
  <Scene class="section flow-scene" id="principle" aria-labelledby="principle-heading" scrub sceneLen={1.5}>
    <div class="container">
      <SectionHead kicker="Our principle" title="Find friction. Build the system that removes it" id="principle-heading" align="center"
        intro="Every CogniElevate product starts with one question: where are people losing time, and what system would make that moment faster, clearer or automatic?" />

      <div class="process-flow flow-steps">
        <article class="card process-step flow-step" style="--t:0;">
          <span class="process-num">01</span>
          <h3>Find wasted time</h3>
          <p style="font-size:0.9rem;">Identify the task, moment, or workflow that keeps slowing people down</p>
        </article>
        <div class="process-arrow" aria-hidden="true">→</div>
        <article class="card process-step flow-step" style="--t:0.4;">
          <span class="process-num">02</span>
          <h3>Build intelligent support</h3>
          <p style="font-size:0.9rem;">Use software, automation, or prediction to simplify the work</p>
        </article>
        <div class="process-arrow" aria-hidden="true">→</div>
        <article class="card process-step flow-step" style="--t:0.75;">
          <span class="process-num">03</span>
          <h3>Create a faster outcome</h3>
          <p style="font-size:0.9rem;">Turn friction into clarity, speed, and less wasted effort</p>
        </article>
      </div>
    </div>
  </Scene>

  <!-- GROUNDED MISSION BAND -->
  <section class="mission-band" aria-labelledby="mission-heading">
    <div class="mission-photo">
      <img
        src="/assets/photos/mountain-k2.jpg"
        alt="K2 in the Karakoram range, northern Pakistan"
        width="1920" height="1274" loading="lazy"
      />
    </div>
    <div class="mission-overlay"></div>
    <div class="container mission-inner" data-reveal>
      <h2 id="mission-heading" class="mission-title">
        Real problems. Real systems
      </h2>
      <p class="mission-text">
        We started in Pakistan with a simple idea: find where people lose time
        and build the system that gives it back. Software today, and hardware
        and robotics as we grow. The same mission across every product
      </p>
    </div>
  </section>

  <!-- SCENE 4 — FIRST PROOF: COGNIFOCUS REVEAL -->
  <Scene class="section reveal-scene" id="showcase" aria-labelledby="showcase-heading">
    <div class="container">
      <SectionHead kicker="What we're building" title="Live now, and building next" id="showcase-heading" align="center"
        intro="CogniFocus is the first product we shipped. Aptelle is the one we are building now. Both run on the same principle: find friction, build the system that removes it" />
      <div class="product-duo">
          <article class="card no-hover card-p-lg depth-panel product-panel">
            <div class="product-panel-head">
              <div class="product-panel-copy">
                <span class="market-badge" style="margin-bottom:0.5rem;">Live</span>
                <h3 style="font-size:1.4rem;margin:0.35rem 0 0.5rem;">CogniFocus</h3>
                <p>A focus system that reacts to your behavior, calls you out when you slip and builds pressure to stay focused</p>
              </div>
              <img src="https://cognifocus.app/assets/logo/app-logo.png" alt="CogniFocus app logo" class="product-logo" loading="lazy" />
            </div>
            <div class="product-pills">
              <span class="outcome-pill">Protect attention</span>
              <span class="outcome-pill">Block distractions</span>
              <span class="outcome-pill">Build momentum</span>
              <span class="outcome-pill">Streaks &amp; XP</span>
            </div>
            <a href="https://cognifocus.app/" target="_blank" rel="noopener" class="btn btn-primary btn-lg" style="margin-top:1.5rem;">
              Visit CogniFocus <span aria-hidden="true">↗</span>
            </a>
          </article>

          <article class="card no-hover card-p-lg depth-panel product-panel">
            <div class="product-panel-head">
              <div class="product-panel-copy">
                <span class="market-badge building" style="margin-bottom:0.5rem;">Building</span>
                <h3 style="font-size:1.4rem;margin:0.35rem 0 0.5rem;">Aptelle</h3>
                <p>Fit intelligence for clothing. Aptelle predicts how something will actually fit so people stop guessing sizes and stop wasting time on returns</p>
              </div>
              <span class="product-logo product-logo-ph" aria-hidden="true">A</span>
            </div>
            <div class="product-pills">
              <span class="outcome-pill">Predict fit</span>
              <span class="outcome-pill">Cut returns</span>
              <span class="outcome-pill">Buy with confidence</span>
            </div>
            <a href="https://aptelle.com/" target="_blank" rel="noopener" class="btn btn-outline btn-lg" style="margin-top:1.5rem;">
              Explore Aptelle <span aria-hidden="true">↗</span>
            </a>
          </article>
      </div>
    </div>
  </Scene>

  <!-- IMMERSIVE BAND — VISION -->
  <section class="mission-band band-vision" aria-labelledby="vision-heading">
    <div class="mission-photo">
      <img
        src="/assets/photos/earthrise.jpg"
        alt="Earth rising over the surface of the Moon"
        width="1200" height="945" loading="lazy"
      />
    </div>
    <div class="mission-overlay"></div>
    <div class="container mission-inner" data-reveal>
      <h2 id="vision-heading" class="mission-title">
        Start small. Aim far
      </h2>
      <p class="mission-text">
        Focus and fit are the start. The same idea reaches into healthcare and
        robotics next. We give people their time back wherever it gets lost
      </p>
    </div>
  </section>

  <!-- SCENE 5 — THE ECOSYSTEM: markets -->
  <Scene class="section ecosystem-scene" id="markets" aria-labelledby="markets-heading">
    <div class="container">
      <SectionHead kicker="Markets" title="One mission across multiple markets" id="markets-heading" align="center"
        intro="CogniElevate is built to grow into the places where time is commonly lost" />

      <div class="grid-4" data-reveal-stagger>
        {markets.map(({ title, body, status }) => (
          <article class="card market-card card-p">
            <span class={`market-badge ${status === 'live' ? '' : status}`}>{marketBadge[status]}</span>
            <h3 style="font-size:1.05rem;margin-bottom:0.6rem;">{title}</h3>
            <p style="font-size:0.88rem;">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </Scene>

  <!-- PRESS -->
  <section class="press-section" aria-label="Press coverage">
    <div class="container">
      <div style="max-width:760px; margin:0 auto;" data-reveal>
        <a
          href="https://startupfortune.com/qasim-built-cognifocus-because-most-focus-apps-keep-counting-while-your-brain-is-already-on-tiktok/"
          target="_blank"
          rel="noopener noreferrer"
          class="press-link"
        >
          <span class="market-badge">Startup Fortune</span>
          <p style="font-size:1.05rem; font-weight:600; color:var(--text); line-height:1.45; margin-bottom:0.75rem;">
            "CogniFocus Catches You Mid-Scroll During a Focus Session: That Is the Entire Point"
          </p>
          <span style="font-size:0.85rem; font-weight:600; color:var(--accent);">Read the story ↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SCENE 6 — FINALE CTA -->
  <CtaPanel
    title="More than one product"
    text="CogniFocus is the first product. The plan is to keep going: shopping, healthcare, robotics, anywhere people keep losing time to the same friction"
  >
    <a href="https://cognifocus.app/" target="_blank" rel="noopener" class="btn btn-primary btn-lg">
      Try CogniFocus <span aria-hidden="true">↗</span>
    </a>
    <a href="/contact/" class="btn btn-outline btn-lg">Get in touch</a>
  </CtaPanel>

</BaseLayout>

<style>
  /* Hero layout rules live in global.css (.hero-scene) because these
     elements render inside the Scene component, outside this page's scope. */

  /* Immersive full-bleed hero */
  .hero-immersive {
    position: relative;
    isolation: isolate;
    min-height: clamp(560px, 82vh, 820px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-immersive-photo { position: absolute; inset: 0; z-index: -2; }
  .hero-immersive-photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .hero-immersive-overlay {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(90deg, rgba(10,25,48,0.95) 0%, rgba(10,25,48,0.78) 42%, rgba(10,25,48,0.42) 100%),
      linear-gradient(180deg, rgba(10,25,48,0.35) 0%, rgba(10,25,48,0.15) 40%, rgba(10,25,48,0.9) 100%);
  }
  .hero-immersive-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(500px, 1.08fr) minmax(420px, 0.92fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4.5rem);
    padding-top: clamp(4rem, 9vw, 6rem);
    padding-bottom: clamp(4rem, 9vw, 6rem);
  }
  .hero-copy { max-width: 640px; }
  .hero-immersive .hero-title { text-shadow: 0 2px 24px rgba(0,0,0,0.45); }
  .hero-immersive .hero-lead { color: rgba(255,255,255,0.82); max-width: 46ch; }

  /* Editorial media wall: current proof, origin, and future vision in one composition. */
  .hero-media-wall {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.2vw, 1rem);
    width: 100%;
    height: clamp(440px, 34vw, 540px);
    min-height: 0;
    justify-self: end;
    margin-right: min(0px, calc((100vw - var(--container)) / -2));
  }
  .media-tile {
    position: relative;
    margin: 0;
    overflow: hidden;
    min-height: 0;
    border-radius: 14px;
    background: var(--primary);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.22);
  }
  .media-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, rgba(100,254,218,0.14), transparent 42%, rgba(10,25,48,0.32));
    pointer-events: none;
  }
  .media-tile img { width: 100%; height: 100%; object-fit: cover; }
  .media-tile-product { grid-column: 1; grid-row: 1; }
  .media-tile-product img { object-position: center 20%; }
  .media-tile-k2 { grid-column: 2; grid-row: 1; }
  .media-tile-k2 img { object-position: 52% 44%; }
  .media-tile-earth { grid-column: 1; grid-row: 2; }
  .media-tile-earth img { object-position: center 45%; }
  .media-tile-session {
    grid-column: 2;
    grid-row: 2;
  }
  .media-tile-session img { object-position: center 35%; }
  .media-tile-session::after { background: linear-gradient(160deg, rgba(10,25,48,0.08), rgba(10,25,48,0.42)); }
  .media-origin-mark {
    position: absolute;
    top: clamp(0.65rem, 1.5vw, 1rem);
    right: clamp(0.65rem, 1.5vw, 1rem);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 42px;
    height: 36px;
    border-radius: 8px;
    background: rgba(10,25,48,0.7);
    backdrop-filter: blur(8px);
  }
  .media-origin-mark img { width: 24px; height: 16px; object-fit: cover; }
  @media (max-width: 1050px) and (min-width: 721px) {
    .hero-immersive-inner { grid-template-columns: minmax(0, 0.9fr) minmax(360px, 0.8fr); }
    .hero-media-wall { width: min(100%, 530px); height: 420px; margin-right: 0; }
  }
  @media (max-width: 720px) {
    .hero-immersive { min-height: clamp(520px, 88vh, 720px); }
    .hero-immersive-inner { grid-template-columns: 1fr; gap: 2rem; }
    .hero-media-wall {
      width: min(100%, 430px);
      height: 248px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
      justify-self: start;
    }
    .hero-immersive-overlay {
      background: linear-gradient(180deg, rgba(10,25,48,0.55) 0%, rgba(10,25,48,0.35) 35%, rgba(10,25,48,0.92) 100%);
    }
  }
  @media (max-width: 430px) {
    .hero-immersive-inner { padding-top: 5rem; }
    .hero-media-wall { height: 215px; gap: 0.5rem; }
    .media-tile { border-radius: 10px; }
    .media-origin-mark { top: 0.5rem; right: 0.5rem; width: 34px; height: 30px; }
    .media-origin-mark img { width: 20px; height: 13px; }
  }

  /* Grounded mission band */
  .mission-band {
    position: relative;
    isolation: isolate;
    min-height: clamp(300px, 34vw, 420px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .mission-photo { position: absolute; inset: 0; z-index: -2; }
  .mission-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .mission-overlay {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(90deg, rgba(10,25,48,0.92) 0%, rgba(10,25,48,0.72) 45%, rgba(10,25,48,0.35) 100%),
      linear-gradient(180deg, rgba(10,25,48,0.55), rgba(10,25,48,0.65));
  }
  .mission-inner { padding: clamp(2rem, 5vw, 3.5rem) var(--container-pad, 1.25rem); max-width: 640px; }
  .mission-title {
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 1rem;
  }
  .mission-text { font-size: clamp(1rem, 1.6vw, 1.15rem); color: var(--text-2); line-height: 1.7; max-width: 52ch; }

  /* Product duo */
  .product-duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
    align-items: start;
  }
  .product-duo .card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 2.4vw, 2rem);
  }
  .product-duo .card .btn { margin-top: 1.25rem; align-self: flex-start; }
  .product-duo .product-pills { margin: 1rem 0 0; }
  .product-logo-ph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.6rem;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid var(--accent-mid);
    border-radius: 14px;
  }
  .market-badge.building {
    background: var(--accent-dim);
    border-color: var(--accent-mid);
    color: var(--accent);
  }
  @media (max-width: 760px) {
    .product-duo { grid-template-columns: 1fr; }
  }

  /* Vision band: Earth sits open on the right, text stays left */
  .mission-band.band-vision .mission-photo img { object-position: 82% 42%; }
  .mission-band.band-vision .mission-overlay {
    background:
      linear-gradient(90deg, rgba(10,25,48,0.94) 0%, rgba(10,25,48,0.68) 45%, rgba(10,25,48,0.28) 100%),
      linear-gradient(180deg, rgba(10,25,48,0.4), rgba(10,25,48,0.55));
  }

  /* ---- Open, less-boxy homepage sections ---- */
  /* More air between the immersive bands and the card blocks */
  .friction-scene, .flow-scene, .reveal-scene, .ecosystem-scene {
    padding-top: var(--section);
    padding-bottom: var(--section);
  }
  .friction-field { gap: clamp(1.5rem, 3.5vw, 2.75rem); }
  .grid-4 { gap: clamp(1.25rem, 3vw, 2.25rem); }

  /* Cards blend into the section instead of sitting in hard boxes */
  .friction-node,
  .ecosystem-scene .market-card,
  .flow-step,
  .process-step {
    background: linear-gradient(165deg, rgba(255,255,255,0.045), rgba(255,255,255,0.012));
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 16px;
    padding: clamp(1.25rem, 1.8vw, 1.6rem);
    box-shadow: none;
  }
  /* Stats sit open, no bordered panel */
  .friction-scene .stats-row {
    background: none;
    border: none;
    border-radius: 0;
    overflow: visible;
  }
  .friction-node:hover,
  .ecosystem-scene .market-card:hover,
  .process-step:hover {
    border-color: var(--accent-mid);
    box-shadow: 0 18px 44px rgba(0,0,0,0.35), 0 0 0 1px rgba(100,254,218,0.06);
    transform: translateY(-3px);
  }
  /* Stats sit open on the background, no boxes */
  .stats-row { gap: clamp(1.5rem, 4vw, 3rem); }
  .stats-row .stat-cell {
    background: transparent;
    padding: 0.5rem 0.75rem;
  }
  /* Product cards a touch airier */
  .product-duo .card { border-radius: 22px; }

  /* Scene 2: friction field — nodes along a central spine */
  .friction-scene { position: relative; }
