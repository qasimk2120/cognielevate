---
import BaseLayout from '../layouts/BaseLayout.astro';
import Scene from '../components/Scene.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaPanel from '../components/CtaPanel.astro';
import {
  coreKeywords,
  organizationSchema,
  websiteSchema,
  cognifocusSoftwareSchema,
  webPageSchema,
  breadcrumbSchema,
} from '../data/seo.js';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    websiteSchema,
    webPageSchema({
      id: 'https://cognielevate.co/products/#webpage',
      url: 'https://cognielevate.co/products/',
      name: 'Products | CogniElevate — Focus Apps & Intelligent Systems',
      description: 'Explore CogniElevate products and market directions, starting with CogniFocus and Aptelle, a fit-intelligence product launching soon.',
      breadcrumb: true,
    }),
    breadcrumbSchema({
      id: 'https://cognielevate.co/products/#breadcrumb',
      items: [
        { name: 'Home', url: 'https://cognielevate.co/' },
        { name: 'Products', url: 'https://cognielevate.co/products/' },
      ],
    }),
    cognifocusSoftwareSchema,
  ]
};

const markets = [
  {
    title: 'Focus & productivity',
    body: 'People lose hours to distraction every day. CogniElevate explores tools designed to protect attention and improve daily output',
    status: 'live',
    product: 'CogniFocus',
    link: 'https://cognifocus.app/',
  },
  {
    title: 'Fit & shopping',
    body: 'Aptelle helps you find your right size in any brand, powered by your body profile and real fit data before you buy',
    status: 'building',
    product: 'Aptelle',
    link: 'https://aptelle.com/',
  },
  {
    title: 'Healthcare systems',
    body: 'Time is lost across care delivery. Future direction: intelligent systems that reduce friction in real-world healthcare workflows',
    status: 'future',
  },
  {
    title: 'Robotics systems',
    body: 'Time is lost in complex coordination. Future direction: intelligent systems that improve perception and efficiency in robotic operations',
    status: 'future',
  },
];
---

<BaseLayout
  title="Products | CogniElevate — Focus Apps & Intelligent Systems"
  description="Explore CogniElevate products and market directions, starting with CogniFocus, a focus system built to protect attention and reduce distractions."
  canonical="https://cognielevate.co/products/"
  keywords={[...coreKeywords, 'CogniFocus product', 'focus app product', 'future AI products', 'productivity startup products']}
  activePage="products"
  schema={schema}
>

  <!-- HERO -->
  <Scene class="hero products-hero" aria-labelledby="products-title">
    <div class="container" style="position:relative;">
      <div style="max-width:760px;" class="fade-up hero-center">
        <h1 id="products-title" class="hero-title">Products built to reduce wasted time</h1>
        <p class="lead" style="margin-top:1.25rem;">
          CogniElevate is starting with productivity and expanding toward markets where better systems can save time, reduce friction, and improve outcomes
        </p>
      </div>
    </div>
  </Scene>

  <!-- COGNIFOCUS -->
  <Scene class="section product-focus" id="cognifocus" aria-labelledby="cf-heading">
    <div class="container">
      <SectionHead kicker="First launched product" title="CogniFocus" id="cf-heading" align="center"
        intro="The first public product from CogniElevate, built to test the core belief that software should reduce friction and help people recover wasted time" />

      <article class="product-proof">
        <div class="product-proof-copy">
          <img src="https://cognifocus.app/assets/logo/app-logo.png" alt="CogniFocus app logo" class="product-logo" loading="lazy" />
          <h3>What CogniFocus includes</h3>
          <p>Focus system that reacts to user behavior, Distraction Shield app blocking, streaks and XP, recovery nudges, and character-driven accountability</p>
          <div class="product-pills">
            <span class="outcome-pill">Protect attention</span>
            <span class="outcome-pill">Block distractions</span>
            <span class="outcome-pill">Build momentum</span>
            <span class="outcome-pill">Streaks & XP</span>
            <span class="outcome-pill">Recovery nudges</span>
          </div>
          <a href="https://cognifocus.app/" target="_blank" rel="noopener" class="btn btn-primary btn-lg" style="margin-top:1.5rem;">
            Visit CogniFocus <span aria-hidden="true">↗</span>
          </a>
        </div>
        <figure class="product-proof-media">
          <img src="/assets/products/cf-phone-wins.png" alt="CogniFocus focus prompt on a phone" loading="lazy" />
        </figure>
      </article>

      <!-- Second product: in development -->
      <div class="next-product card no-hover card-p" data-reveal>
        <span class="market-badge future">In development</span>
        <h3>Aptelle</h3>
        <p>Fit intelligence for online fashion, helping people find their right size in any brand with more confidence</p>
        <a href="https://aptelle.com/" target="_blank" rel="noopener" class="read-more" style="display:inline-block;margin-top:.9rem;">Explore Aptelle <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </Scene>

  <!-- MARKETS -->
  <Scene class="section product-markets" id="markets" aria-labelledby="markets-heading" style="background:var(--surface);">
    <div class="container">
      <SectionHead kicker="Markets we are exploring" title="Where we are building next" id="markets-heading" align="center"
        intro="CogniElevate is building a model that can move across categories wherever time is commonly lost" />

      <div class="market-list" data-reveal-stagger>
        {markets.map(({ title, body, status, product, link }) => (
          <article class="card market-card card-p">
            <span class={`market-badge ${status === 'live' ? '' : status}`}>
              {status === 'live' ? 'Live now' : status === 'building' ? 'Building' : 'Future'}
            </span>
            <h3 style="font-size:1.05rem;margin-bottom:0.6rem;">{title}</h3>
            <p style="font-size:0.88rem;margin-bottom:auto;">{body}</p>
            {product && link && (
              <a href={link} target="_blank" rel="noopener" class="read-more" style="margin-top:1rem;">
                {product} <span aria-hidden="true">↗</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </Scene>

  <!-- CTA -->
  <CtaPanel
    title="Follow the product ecosystem"
    text="CogniFocus is live now and Aptelle is launching soon as CogniElevate builds intelligent systems across everyday friction"
  >
    <a href="https://cognifocus.app/" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Visit CogniFocus <span aria-hidden="true">↗</span></a>
    <a href="/contact/" class="btn btn-outline btn-lg">Partner with us <span aria-hidden="true">↗</span></a>
  </CtaPanel>

</BaseLayout>

<style>
  .product-proof {
    align-items: center;
    border-bottom: 1px solid var(--border);
    border-top: 1px solid var(--border);
    display: grid;
    gap: clamp(2rem, 8vw, 8rem);
    grid-template-columns: minmax(0, 1fr) minmax(190px, 320px);
    margin: 0 auto;
    max-width: 980px;
    padding: clamp(2rem, 5vw, 4.5rem) 0;
  }
  .product-proof-copy { max-width: 46ch; }
  .product-proof-copy .product-logo { height: 58px; margin-bottom: 1.25rem; width: 58px; }
  .product-proof-copy h3 { font-size: clamp(2rem, 3vw, 3rem); margin-bottom: .75rem; }
  .product-proof-copy .product-pills { margin-top: 1.5rem; }
  .product-proof-media { margin: 0; justify-self: end; max-width: 250px; }
  .product-proof-media img { width: 100%; }
  .next-product { border-bottom: 1px solid var(--border); margin: 0 auto; max-width: 720px; padding: 1.5rem 0; }
  .next-product h3 { font-size: 1.4rem; margin-bottom: .55rem; }
  .next-product p { font-size: .96rem; }
  .next-product-note { display: block; font-size: .82rem; margin-top: .9rem; }
  .market-list { display: grid; gap: 0 clamp(2rem, 7vw, 7rem); grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0 auto; max-width: 1000px; }
  .market-card { border-bottom: 1px solid var(--border); border-top: 1px solid var(--border); padding: 1.4rem 0; }
  .market-list .market-card:nth-child(n + 3) { border-top: 0; }
  @media (max-width: 760px) {
    .product-proof, .market-list { grid-template-columns: 1fr; }
    .product-proof-media { justify-self: start; max-width: 210px; }
    .market-list .market-card:nth-child(n + 3) { border-top: 1px solid var(--border); }
  }
</style>
