---
import BaseLayout from '../layouts/BaseLayout.astro';
import Scene from '../components/Scene.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaPanel from '../components/CtaPanel.astro';
import {
  coreKeywords,
  organizationSchema,
  websiteSchema,
  webPageSchema,
  breadcrumbSchema,
  faqSchema,
} from '../data/seo.js';

const faqItems = [
  {
    question: 'What is CogniElevate?',
    answer: 'CogniElevate is a technology company building intelligent products and systems that reduce wasted time across several markets.',
  },
  {
    question: 'Is CogniElevate only CogniFocus?',
    answer: 'No. CogniFocus is the first launched product, while Aptelle is the next fit-intelligence product launching soon for clothing and shopping.',
  },
  {
    question: 'What is the long-term vision of CogniElevate?',
    answer: 'The long-term vision is to create intelligent systems that remove friction and improve outcomes wherever people lose time.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    websiteSchema,
    webPageSchema({
      id: 'https://cognielevate.co/about/#webpage',
      url: 'https://cognielevate.co/about/',
      name: 'About CogniElevate | Intelligent Products Company',
      description: 'CogniElevate builds intelligent products that remove friction and reduce wasted time across productivity, healthcare, shopping and robotics.',
      breadcrumb: true,
    }),
    breadcrumbSchema({
      id: 'https://cognielevate.co/about/#breadcrumb',
      items: [
        { name: 'Home', url: 'https://cognielevate.co/' },
        { name: 'About', url: 'https://cognielevate.co/about/' },
      ],
    }),
    faqSchema(faqItems),
  ]
};

const problemCards = [
  { title: 'Attention lost',    body: 'Small interruptions break focus and drain momentum before meaningful work begins' },
  { title: 'Decisions delayed', body: 'Unclear choices create hesitation and slow action across personal and professional life' },
  { title: 'Returns & rework',  body: 'Mistakes turn into extra time, cost and repeated effort that compounds over time' },
  { title: 'Operations slowed', body: 'Manual workflows create drag inside everyday systems, from clinics to warehouses' },
];

const outcomeCards = [
  { title: 'Faster decisions',             body: 'Less hesitation, clearer next steps, faster momentum' },
  { title: 'Fewer repeated mistakes',      body: 'Systems can prevent the same error from happening again' },
  { title: 'More attention for real work', body: 'People spend time on important work instead of drag' },
];

const principleSteps = [
  { num: '01', title: 'Observe the real cost',            body: "We start with the exact moment where time is being lost and ask what is causing it" },
  { num: '02', title: 'Build the system around it',       body: "Create a system designed specifically to remove that friction" },
  { num: '03', title: 'Measure whether time came back',   body: "Keep building until the outcome is real and people recover meaningful time" },
];
---

<BaseLayout
  title="About CogniElevate | Intelligent Products Company"
  description="CogniElevate builds intelligent products that remove friction and reduce wasted time across productivity, healthcare, shopping and robotics."
  canonical="https://cognielevate.co/about/"
  keywords={[...coreKeywords, 'about CogniElevate', 'intelligent products company', 'AI productivity startup']}
  activePage="about"
  schema={schema}
>

  <!-- PAGE HERO -->
  <Scene class="hero about-hero" aria-labelledby="about-title">
    <Fragment slot="far">
      <div class="glow-top"></div>
      <div class="glow-field primary" style="width:50vw;height:40vh;top:-10%;right:-10%;"></div>
    </Fragment>
    <div class="container" style="position:relative;">
      <div style="max-width:760px;" class="fade-up hero-center">
        <h1 id="about-title" class="hero-title">The company building intelligent time-saving systems</h1>
        <p class="lead" style="margin-top:1.25rem;">
          CogniElevate creates intelligent products that remove friction, speed up decisions and reduce wasted time across everyday life and complex industries
        </p>
      </div>
    </div>
  </Scene>

  <!-- PROBLEM -->
  <Scene class="section about-problem" id="problem" aria-labelledby="problem-heading">
    <div class="container">
      <SectionHead kicker="The problem" title="Time gets lost in small moments" id="problem-heading" align="center"
        intro="Distractions, wrong purchases, waiting rooms, admin work and slow systems all create the same cost: wasted time" />
      <div class="about-problem-list" data-reveal-stagger>
        {problemCards.map(({ title, body }) => (
          <article class="card card-p">
            <h3 class="u-draw" style="font-size:1.05rem;margin-bottom:0.6rem;">{title}</h3>
            <p style="font-size:0.9rem;">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </Scene>

  <!-- PRINCIPLE — vertical philosophy spine -->
  <Scene class="section about-principle" id="principle" style="background:var(--surface);" aria-labelledby="principle-heading">
    <Fragment slot="far">
      <div class="glow-field accent" style="width:45vw;height:60vh;top:15%;left:50%;translate:-50% 0;opacity:0.4;"></div>
    </Fragment>
    <div class="container">
      <SectionHead kicker="Our principle" title="We look for friction, then build the system that removes it" id="principle-heading" align="center"
        intro="Every CogniElevate product starts with a simple question: where are people losing time, and what system would make that moment faster, clearer or automatic" />

      <div class="spine">
        <div class="spine-line" aria-hidden="true"></div>
        {principleSteps.map(({ num, title, body }) => (
          <div class="spine-station" data-reveal>
            <span class="spine-marker" aria-hidden="true">
              <span class="spine-dot"></span>
            </span>
            <article class="card no-hover card-p spine-card depth-panel">
              <span class="process-num">{num}</span>
              <h3>{title}</h3>
              <p style="font-size:0.9rem;">{body}</p>
            </article>
          </div>
        ))}
      </div>
    </div>
  </Scene>

  <!-- OUTCOMES -->
  <Scene class="section about-outcomes" id="outcomes" aria-labelledby="outcomes-heading">
    <div class="container">
      <SectionHead kicker="Outcomes" title="Less wasted time means better outcomes" id="outcomes-heading" align="center" />
      <div class="grid-3 outcome-list" data-reveal-stagger>
        {outcomeCards.map(({ title, body }) => (
          <article class="card card-p outcome-card">
            <span class="outcome-node" aria-hidden="true"></span>
            <h3 style="font-size:1.05rem;margin-bottom:0.6rem;">{title}</h3>
            <p style="font-size:0.9rem;">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </Scene>

  <!-- CTA -->
  <CtaPanel
    title="See what we have built first"
    text="CogniFocus is live now and Aptelle is the next step in the CogniElevate product ecosystem"
  >
    <a href="https://cognifocus.app/" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Visit CogniFocus <span aria-hidden="true">↗</span></a>
    <a href="/products/" class="btn btn-outline btn-lg">See all products <span aria-hidden="true">↗</span></a>
    <a href="/founder/" class="btn btn-ghost btn-lg">The founder <span aria-hidden="true">↗</span></a>
  </CtaPanel>

</BaseLayout>

<style>
  /* Philosophy spine */
  .spine {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-left: 0;
    border-top: 1px solid var(--border);
  }
  .spine-line { display: none; }
  .spine-station { position: relative; }
  .spine-marker {
    position: absolute;
    display: none;
    top: 1.6rem;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .spine-dot { display: none; }
  .spine-card { border: 0; border-bottom: 1px solid var(--border); padding: 1.35rem 0; }
  .about-problem-list {
    display: grid;
    gap: 0 clamp(2rem, 6vw, 6rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 auto;
    max-width: 920px;
  }
  .about-problem-list .card { border-top: 1px solid var(--border); padding: 1.25rem 0; }
  .about-problem-list .card:nth-last-child(-n + 2) { border-bottom: 1px solid var(--border); }
  .outcome-list { border-top: 1px solid var(--border); gap: 0 clamp(1.5rem, 5vw, 5rem); margin: 0 auto; max-width: 1000px; }
  .outcome-list .outcome-card { border-bottom: 1px solid var(--border); padding: 1.25rem 0; }
  @media (max-width: 760px) {
    .about-problem-list { grid-template-columns: 1fr; }
    .about-problem-list .card:nth-last-child(-n + 2) { border-bottom: 0; }
    .about-problem-list .card:last-child { border-bottom: 1px solid var(--border); }
  }
</style>
