---
const socials = [
  { href: 'https://www.tiktok.com/@cognielevate',        label: 'TikTok',    icon: 'tiktok'    },
  { href: 'https://www.instagram.com/cognifocus.app/',   label: 'Instagram', icon: 'instagram' },
  { href: 'https://www.facebook.com/share/1Am7kCzkjG/', label: 'Facebook',  icon: 'facebook'  },
  { href: 'https://x.com/iqasim_explores',                  label: 'X',         icon: 'x'         },
  { href: 'https://discord.gg/HbU3XYyFCz',              label: 'Discord',   icon: 'discord'   },
  { href: 'https://wa.me/923262878356',                  label: 'WhatsApp',  icon: 'whatsapp'  },
];

const navLinks = [
  { href: '/',          label: 'Home'         },
  { href: '/about/',     label: 'About'        },
  { href: '/founder/',   label: 'Founder'      },
  { href: '/products/',  label: 'Products'     },
  { href: 'https://aptelle.com/', label: 'Aptelle', external: true },
  { href: '/blog/',      label: 'Blog'         },
  { href: '/resources/', label: 'Resources'    },
  { href: '/contact/',   label: 'Contact'      },
  { href: '/privacy/',   label: 'Privacy'      },
];

const questions = [
  {
    question: 'What is CogniElevate?',
    answer: 'CogniElevate is a technology company building intelligent products that reduce wasted time, starting with CogniFocus in the focus and productivity space',
  },
  {
    question: 'Is CogniElevate only CogniFocus?',
    answer: 'CogniFocus is the first launched product, with Aptelle extending the ecosystem into fit intelligence for shopping',
  },
  {
    question: 'What is the long-term vision?',
    answer: 'To build intelligent systems that remove friction wherever people lose time',
  },
];
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-inner">
      <section class="footer-faq" aria-labelledby="footer-faq-heading">
        <div class="footer-faq-intro">
          <p class="kicker">FAQ</p>
          <h2 id="footer-faq-heading">Questions about CogniElevate</h2>
        </div>
        <div class="footer-faq-list">
          {questions.map(({ question, answer }) => (
            <details class="footer-faq-item">
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>
      <div class="footer-top">
        <div class="footer-brand">
          <a href="/" aria-label="CogniElevate home">
            <img src="/assets/cognielevate.png" alt="CogniElevate" width="120" height="28" />
          </a>
          <p>Intelligent systems that give people their time back</p>
          <div class="socials mt-lg">
            {socials.map(({ href, label, icon }) => (
              <a
                href={href}
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
              >
                <img
                  src={`/assets/icons/${icon}.svg`}
                  alt=""
                  aria-hidden="true"
                  width="16"
                  height="16"
                />
              </a>
            ))}
          </div>
        </div>

        <nav class="footer-links" aria-label="Footer navigation">
          {navLinks.map(({ href, label, external }) => (
            <a href={href} class="footer-link" target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>{label}</a>
          ))}
        </nav>
      </div>

      <div class="footer-bottom">
        <span style="display:inline-flex;align-items:center;gap:0.5rem;">
          © 2026 CogniElevate. All rights reserved.
          <span style="display:inline-flex;align-items:center;gap:0.35rem;opacity:0.75;">
            <img src="/assets/photos/flag-pakistan.svg" alt="" aria-hidden="true" width="18" height="12" style="border-radius:2px;" />
            Built in Pakistan
          </span>
        </span>
        <a
          href="https://cognifocus.app/"
          target="_blank"
          rel="noopener"
          style="color: var(--accent); text-decoration: none; font-weight: 500;"
        >
          Try CogniFocus <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</footer>
